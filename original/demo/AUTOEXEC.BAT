@ECHO OFF
CLS
ECHO.
ECHO  Original AUTOCONF 1991 boot demonstration
ECHO.
READCONF.COM
IF ERRORLEVEL 3 GOTO CONFIG_C
IF ERRORLEVEL 2 GOTO CONFIG_B
IF ERRORLEVEL 1 GOTO CONFIG_A
GOTO CONFIG_UNKNOWN

:CONFIG_C
ECHO  C - Windows 95
GOTO CONFIG_DONE

:CONFIG_B
ECHO  B - DOOM
GOTO CONFIG_DONE

:CONFIG_A
ECHO  A - Minimal DOS
GOTO CONFIG_DONE

:CONFIG_UNKNOWN
ECHO  Unknown configuration

:CONFIG_DONE
ECHO  The configuration selected by AUTOCONF has been applied.
ECHO.
VER
ECHO.
