hlp_msg db '²╔══════════════════════════════════════════════════════════════════════════════╗',10
	db '║ Chers utilisateurs, merci d''avoir choisi ²AUTOCONF:². Vous ne regretterez pas  ║',10
	db '║ ce bon choix!                                                         D.D.   ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
        db '║    ²CE QUE EST ²AUTOCONF:²                                                      ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²AUTOCONF² est un programme, permettant de choisir au démarrage de votre       ║',10
	db '║ ordinateur, différentes configurations des gestionnaires de mémoire, des     ║',10
	db '║ périfériques ou d''autres résidents, en fonction des logiciels que l''utili-   ║',10
	db '║ sateur désire employer par la suite dans son travail.                        ║',10
	db '║ ²AUTOCONF² est un programme très souple, et possède de nombreux avantages au   ║',10    
	db '║ niveau de l''utilisation que de nombreux logiciels semblables n''ont pas.      ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║    ²POURQUOI BESOIN DE CONFIGURATIONS MULTIPLES?         ²                     ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ Avez-vous déjà eu des erreurs de ''Mémoire Insuffisante''? Votre gestionnaire  ║',10
	db '║ souris prend 20k et il vous énerve lorsque vous n''en avez pas besoin et que  ║',10
	db '║ la mémoire manque pour un autre programme?                                   ║',10
	db '║                                                                              ║',10
	db '║ Combien de fois éditez-vous le fichier CONFIG.SYS pour y rajouter des REMs?  ║',10
	db '║ Ou pire, combien de CONFIG.SYSs avez vous créé et que vous copiez au besoin? ║',10
	db '║ Ou encore, combien de disquettes boot trainent sur votre bureau? Quel temps  ║',10
	db '║ précieux vous perdez! Si vous avouez être victime d''une telle injustice...   ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²...dans ce cas ²AUTOCONF² est ce qu''il vous faut!!!²                            ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ Vous avez désormais LE PROGRAMME PARFAIT pour les configurations multiples   ║',10
	db '║ dans UN SEUL fichier CONFIG.SYS et UN SEUL fichier AUTOEXEC.BAT. Si vous     ║',10
	db '║ utilisez déjà un programme du genre ²AUTOCONF², voici une courte explication   ║',10
	db '║ et comparaison entre ce qu''²AUTOCONF² fait, et que des programmes connus comme ║',10
	db '║ Configurations Multiples du DOS 6.x, MBOOT 2.x et LACE 1.x ne font pas!      ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²AUTOCONF² permet de créer plus de 200 configurations différentes, accessibles ║',10
	db '║ par une touche du clavier, par les codes étendus (ALT + touche) ou encore    ║',10
	db '║ pas les touches de fonctions (F1...F10).                                     ║',10 
	db '║                                                                              ║',10
	db '║ Ceci est le moins important,  car l''avantage le  plus grand d''²AUTOCONF² est   ║',10
	db '║ certainement qu''il ne DOIT PAS ARRETER L''EXECUTION DU CONFIG.SYS EN AUCUN    ║',10
	db '║ CAS (à moins que vous ne le vouliez) : vous choisissez une configuration     ║',10
	db '║ avant le chargement d''²AUTOCONF² en  simplement  appuyant  sur  une touche du  ║',10
	db '║ clavier qui désigne une configuration prédéfinie dans le CONFIG.SYS,  après  ║',10
	db '║ le test de la RAM et le laconique message WAIT... si vous avez l''AMI BIOS.   ║',10
	db '║                                                                              ║',10
	db '║ Souvent, vous ne trouvez dans les logiciels semblables, qu''un menu, rarement ║',10
	db '║ très riche en imagination ou en couleurs, dans lequel l''utilisateur est      ║',10
	db '║ forcé de choisir une configuration. Dans le meilleur des cas, une config     ║',10
	db '║ par défaut est chargée. Pour choisir une configuration avec ²AUTOCONF², il     ║',10
	db '║ suffit d''appuyer sur une seule touche, ce qui vous fait gagner du temps si   ║',10
	db '║ précieux!                                                                    ║',10
	db '║                                                                              ║',10
        db '║ Il est possible de créer des sous groupes de configurations, accésibles      ║',10
        db '║ depuis la liste. La configuration principale qui contient le groupe peut     ║',10
        db '║ aussi être chargée! Vous pouvez aller dans n''importe quel groupe et même     ║',10
        db '║ en revenir (pas comme avec quelques logiciels de configurations multiples    ║',10
        db '║ que je ne citerais pas). Une fleche vous indique dans la liste des configs,  ║',10
        db '║ si cette configuration est aussi un groupe!                                  ║',10
	db '║                                                                              ║',10
        db '║ ²AUTOCONF² possède une aide on-line, supporte des pages indéfiniment multiples ║',10
	db '║ pour la liste des configurations, des modes couleur et n/b, 25 et 50 lignes, ║',10
	db '║ le chargement de seulement la partie commune, arrêt immédiat en cas de       ║',10
	db '║ demande, etc...                                                              ║',10
	db '║                                                                              ║',10
	db '║ ²AUTOCONF² possède une fonction UNIQUE que vous pouvez appeller depuis la liste║',10
	db '║ des configurations: l''affichage de la configuration même!                    ║',10
	db '║                                                                              ║',10
        db '║ Encore plus épatant! Vous pouvez activer ou desactiver temporairement une    ║',10
        db '║ ligne dans une configuration!                                                ║',10
        db '║                                                                              ║',10
	db '║ ²AUTOCONF² est très rapide, vous ne remarquez jamais le ralentissement qu''il   ║',10
	db '║ cause à votre ordinateur au démarrage! Ces milliers de lignes de code en ASM ║',10
	db '║ ont été soigneusement travaillées, afin de ne rien exécuter d''inutile.       ║',10
	db '║                                                                              ║',10
	db '║ Nombreuses options indispensables ou pratiques sont à votre disposition.     ║',10
	db '║ ²AUTOCONF² est 100% compatible QEMM 7.x, dont le DOSDATA créait des problèmes  ║',10
	db '║ incroyables pour les logiciels de configurations multiples. Vous ne pouvez   ║',10
	db '║ malheureusement pas lancer OPTIMIZE de QEMM, car il ignorera ²AUTOCONF² et     ║',10
	db '║ entrainera toutes les configurations à être chargées une après l''autre.      ║',10
	db '║                                                                              ║',10
        db '║ ²AUTOCONF² est compatible Windows 95!                                          ║',10
	db '║                                                                              ║',10
	db '║ Un mode silencieux ou invisible rend le démarrage de votre ordinateur        ║',10
	db '║ totalement ordinaire, mais tout en conservant la possibilité de choix de     ║',10
	db '║ configurations. ²AUTOCONF² supporte tous les claviers supportés par KEYB.COM   ║',10
	db '║ du DOS!                                                                      ║',10
	db '║                                                                              ║',10
	db '║ ²AUTOCONF² ne prend pas de mémoire!                                            ║',10
	db '║                                                                              ║',10
	db '║ L''utilisation est tellement simple que le manuel n''est nécessaire qu''une     ║',10
	db '║ seule fois, si vous ne trouvez pas par intuition comment ça marche.          ║',10
	db '║                                                                              ║',10
	db '║ Je pourrais baratiner encore longtemps, mais je préfère passer à la suite.   ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ Enfin, ²AUTOCONF² est ²îGRATUIT² pour un usage personnel. (Si vous croyez que je  ║',10
	db '║ mérite une récompense n''hésitez pas à me remercier financièrement.) Une      ║',10
	db '║ société à but financier, est certainement en mesure de payer le peu que je   ║',10
	db '║ demande, et ainsi reçevoir aussi les upgrades réguliers.                     ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ Si vous voulez recevoir constamment des nouvelles versions d''²AUTOCONF²:       ║',10
	db '║ $10 (Suisse), $20 (Europe), et $30 (Etats Unis, etc...) par année.           ║',10
	db '║ Ou contactez moi par modem (appeler avant) ou envoyez encore le numéro du    ║',10
	db '║ BBS ou je peux le laisser.                                                   ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²COMME ²AUTOCONF² EST GRATUIT, LA VENTE DE LA VERSION QUELCONQUE EST INTERDITE! ²║',10
	db '║ ²SI VOUS DESIREZ PERSONALISER VOTRE COPIE, ENREGISTREZ VOUS (POINT PRECEDENT)² ║',10
	db '║ ²TOUT INDIVIDU ESSAYANT DE TIRER QUELCONQUE PROFIT DE CE LOGICIEL, SERA ²      ║',10
	db '║ ²POURSUIVI D''APRES LA LOI SUISSE!                                            ² ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ Consultez WHATSNEW.FR  pour savoir ce qui a changé de la version précédente. ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²AUTOCONF² existe en ANGLAIS et en FRANCAIS. Si vous voulez une version RUSSE  ║',10
	db '║ contactez moi!                                                               ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²                       LE MANUEL COMPLET DE ²AUTOCONF:²                        ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²PARAMETRES DANS LE CONFIG.SYS ²                                               ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║  (vous pouvez commencer une option avec / ou -)                              ║',10
	db '║                                                                              ║',10
	db '║ ²/Dx² : configuration par défaut. Cette option change la configuration         ║',10
	db '║       par défaut chargée si vous n''appuyez pas sur une touche qui désigne    ║',10
	db '║       une autre configuration. (sans cette option, la configuration par      ║',10
	db '║       défaut est la configuration A).                                        ║',10
	db '║ Note: pour les configurations étendues (F1...F10) mettez /DF1.../DF0.        ║',10
	db '║ Note: vous ne pouvez spécifier que des configurations du groupe principal.   ║',10
	db '║                                                                              ║',10
        db '║ ²/Hx² : la configuration par défaut pour Windows 95.                           ║',10
        db '║       ²AUTOCONF² detecte la présence de DOS 7.00, sous lequel tourne Win 95,   ║',10
	db '║       et active ce switch dans ce cas. Consultez le chapitre ''Compatibilité  ║',10
        db '║       avec Windows 95'', plus loin dans l''aide.                               ║',10
	db '║                                                                              ║',10
        db '║ ²/T²[²Dx²[²u²]][²Cx²[²u²]]² : le temps qu''²AUTOCONF² attendra une touche de la part de    ║',10
        db '║       l''utilisateur. Normalement vous avez suffisamment de temps pour choisir║',10
        db '║       une configuration avant le lancement d''²AUTOCONF², après le laconique    ║',10
        db '║       message du demarrage du dos.                                           ║',10
        db '║                                                                              ║',10
        db '║ [²D²]: spécifie le temps d''attente sous DOS inférieur à 7.00                   ║',10
        db '║ [²C²]: spécifie le temps d''attente sous DOS 7.00 et supérieur (Windows 95).    ║',10
        db '║ [²u²]: ne pas afficher la pulsation pendant l''attente, ex: ²/T5u²                ║',10
	db '║                                                                              ║',10
        db '║ Exemple: /TD2uC3u forcera ²AUTOCONF² d''attendre 2 secondes sous DOS et 3 sous  ║',10
        db '║          Windows 95; /T5 forcera ²AUTOCONF² d''attendre toujours 5 secondes.    ║',10
        db '║                                                                              ║',10
        db '║ Note: l''ordre des options n''est pas important, ex: /TC2D4u = /TD4uC2         ║',10
        db '║                                                                              ║',10
	db '║ ²/P² :  mode silencieux: si les (magnifiques) messages de ²AUTOCONF² vous        ║',10
	db '║       dérangent vous pouvez les faire totalement disparaître.                ║',10
	db '║ Note: la liste de configurations et le manuel seront tout de même affichés   ║',10
	db '║       si vous les demandez. Les erreurs seront aussi signalées.              ║',10
	db '║                                                                              ║',10
	db '║ ²/N² :  ne pas effacer l''écran au chargement d''²AUTOCONF².                       ║',10
	db '║                                                                              ║',10
	db '║ ²/E² :  messages en noir et blanc. Si les superbes messages en couleur  vous   ║',10
	db '║       dérangent, alors utilisez cette option. C''est aussi utile pour ceux    ║',10
	db '║       qui ont un écran LCD avec un faible nombre de niveaux de gris, car     ║',10
	db '║       les messages de couleurs sombres sont alors peu lisibles.              ║',10
	db '║                                                                              ║',10
	db '║ ²/Kxx² :  clavier utilisé, où xx:                                              ║',10
	db '║                                                                              ║',10
	db '║   Belgique                     ²BE²  │ Brésil                       ²BR²         ║',10
	db '║   Canada fr.                   ²CF²  │ Tchécoslovaquie (tchéque)    ²CZ²         ║',10
	db '║   Tchécoslovaquie (slovaque)   ²SL²  │ Danemark                     ²DK²         ║',10
	db '║   Finlande                     ²SU²  │ France                       ²FR²         ║',10
	db '║   Allemagne                    ²GR²  │ Hongrie                      ²HU²         ║',10
	db '║   Italie                       ²IT²  │ Amérique latine              ²LA²         ║',10
	db '║   Pays-Bas                     ²NL²  │ Norvège                      ²NO²         ║',10
	db '║   Pologne                      ²PL²  │ Portugal                     ²PO²         ║',10
	db '║   Espagne                      ²SP²  │ Suède                        ²SV²         ║',10
        db '║   Suisse (romande)             ²SF²  │ Suisse (allémanique)         ²SG²         ║',10
	db '║   Royaume-Uni                  ²UK²  │ Croatie/Serbie/Slovénie      ²YU²         ║',10
	db '║                                                                              ║',10
	db '║ Le clavier ²US² (Etats Unis) est celui par défaut.                             ║',10
	db '║                                                                              ║',10
	db '║ ²/J²[²D²][²C²] : toujours afficher une liste de configurations et demander à  en   ║',10
        db '║      choisir une.                                                            ║',10
	db '║ [²D²]: toujours afficher la liste sous DOS inférieur à 7.00                    ║',10
        db '║ [²C²]: toujours afficher la liste sous DOS 7.00 et supérieur (Windows 95).     ║',10
        db '║      Note: ²/J² sans autres active les deux options.                           ║',10
        db '║      Note: l''ordre des options n''est pas important, ex: /JCD, /JDC, ou /JD.  ║',10
	db '║                                                                              ║',10
        db '║ En combinant les options ²/Jxx² et ²/T², vous obtenez au démarrage la liste des  ║',10
        db '║ configurations qui disparaitra après le temps défini par /Tx pour charger la ║',10
        db '║ configuration par défaut. Si vous appuyez sur une touche pendant le temps    ║',10
        db '║ d''attente, la liste des configuration réagira normalement et annulera le     ║',10
        db '║ décompte. L''option /TDx n''influencera que /JD et /TCx que /JC.               ║',10
        db '║                                                                              ║',10
	db '║ ²/S² : Au démarrage ²AUTOCONF² crée un fichier ²AUTOCONF.DAT².                     ║',10
	db '║      qui contien la configuration choisie lors du dérnier démarrage. Avec    ║',10
	db '║      cette option, si aucune touche n''a été appuyée ²AUTOCONF² charge la       ║',10
	db '║      configuration choisie au dérnier démarrage de votre ordinateur.         ║',10
	db '║                                                                              ║',10
        db '║ Note: ²AUTOCONF.DAT² est toujours crée et modifié é chaque démarrage.          ║',10
        db '║      Ce fichier est modifié par iREAD (integrated READCONF) et utilisé par   ║',10
        db '║      BOOTIT pour les reboots preprogrammés.                                  ║',10
	db '║                                                                              ║',10
	db '║ NB:  Cette option n''a aucun sens  utilisée avec ²/J².                          ║',10
	db '║                                                                              ║',10
	db '║ ²/Mx² : Au démarrage ²AUTOCONF² affiche des message de bienvenue qui dépendent   ║',10
	db '║      de l''heure à laquelle vous allumez votre ordinateur. Cette option       ║',10
	db '║      permet de chager les (fabuleux) messages d''initialisation:              ║',10
	db '║                                                                              ║',10
	db '║            ²/M1² - message du matin                                            ║',10
	db '║            ²/M2² - message de la journée                                       ║',10        
	db '║            ²/M3² - message du soir                                             ║',10
	db '║            ²/M4² - message de la nuit                                          ║',10
	db '║                                                                              ║',10
	db '║  Le même message peut être assigné aux quatres messages de la journée:       ║',10
	db '║                                                                              ║',10
	db '║ ²/M[xxxx]² : où x est le numéro du message                                     ║',10        
	db '║                                                                              ║',10
	db '║ Ainsi si vous rajouter une option tel que:                                   ║',10
	db '║                                                                              ║',10
	db '║         ²  /M[13]I|l fait beau,#les oiseaux chantent... ²                      ║',10
	db '║                                                                              ║',10
	db '║ ²AUTOCONF² affichera pour les messages du matin et du soir:                    ║',10
	db '║                                                                              ║',10
	db '║ ²Il fait beau,²                                                                ║',10
	db '║ ²les oiseaux chantent... ²                                                     ║',10
	db '║                                                                              ║',10
	db '║ Note: chaque message peut avoir une infinité de caractères  tant que la      ║',10        
	db '║       ligne du device=AUTOCONF tient sur une ligne. Le caractère ²|²  sert     ║',10
	db '║       à distinguer les majuscules des minuscules. Le caractère ²#² sert à      ║',10
	db '║       distinguer les lignes. (il fait le saut de lignes) Si le nombre de     ║',10
	db '║       caractères dépasse 77 alors le messages est renvoyé sur la ligne       ║',10
	db '║       suivante de toute façon.                                               ║',10
	db '║ Par exemple: ²device=AUTOCONF.SYS /M3s|alut cher #|u|tilisateur d''|AUTOCONF²   ║',10
	db '║ donnera sur l''écran après le message d''initalisation:                        ║',10
	db '║                                                                              ║',10
	db '║ ²Salut cher²                                                                   ║',10
	db '║ ²Utilisateur d''AUTOCONF²                                                       ║',10        
	db '║                                                                              ║',10
	db '║ Note: si vous désirez afficher des caractères tels que ²| / - ou #,² qui       ║',10        
	db '║       sont normalement considérés comme des caractères de contrôle, écrivez  ║',10                
	db '║       les simplement deux fois de suite: ²|| // -- ou ##².                     ║',10        
	db '║                                                                              ║',10
	db '║ ²/Cx² : Si vous demandez la liste des configurations, celle-ci met en          ║',10        
	db '║       évidence la lettre qui designe la configuration sur laquelle le        ║',10
	db '║       curseur se trouve. Cette option définit la couleur du curseur et de    ║',10
	db '║       la configuration mise en évidence.                                     ║',10
	db '║       Défaut est 127.                                                        ║',10
	db '║ ex:² /C}² (Alt 125) donnera des caractères bleus clairs sur un fond gris.      ║',10
	db '║                                                                              ║',10
        db '║ ²/Fx² : Définit la couleur des désignations des configurations dans la liste.  ║',10        
        db '║       (même syntaxe que pour ²/Cx²)                                            ║',10
        db '║                                                                              ║',10
	db '║ ²/G²  : L''option pour les plus capricieux: avant chaque liste de configs,      ║',10
	db '║       un message qui indique quelles touches peuvent être utilisées afin de  ║',10
	db '║       choisir une configuration, voir une configuration ou afficher l''aide   ║',10
	db '║       est affiché. Cette option permet de ne pas afficher ce message!        ║',10
	db '║                                                                              ║',10
        db '║ ²/5²  : Forcer un mode de 50 lignes sur l''ecran. Ceci signifie que ²AUTOCONF²    ║',10        
	db '║       utilisera ce mode par défaut pour tout affichage et retiendra cet      ║',10
	db '║       état après avoir terminé son exécution.                                ║',10
	db '║                                                                              ║',10
        db '║ ²/O²  : Mode de compatibilité de Windows 95, et MS-DOS inférieur à 7.00,       ║',10
	db '║       utilisant DOSDATA de QEMM. Pour des informations détaillées consultez  ║',10
        db '║       le chapitre ''Compatibilité avec Windows 95'', point 3.                  ║',10
        db '║                                                                              ║',10
        db '║ ²/I²  : Désactiver le mode d''edition dans le visionneur des configurations.    ║',10
        db '║                                                                              ║',10
        db '║ ²/L²  : Toujours afficher le nom de la configuration au démarrage.             ║',10
        db '║                                                                              ║',10
        db '║ ²/B²  : Ne pas créer le fichier caché AUTOCONF.DAT, effacer si''il existe.      ║',10
        db '║       /S n''aura aucun effet, BOOTIT ne sera pourtant pas ignoré!             ║',10
        db '║                                                                              ║',10
        db '║ ²/Z²  : mode eLiTe! (pas pour les lamers!) ²/ZZ² inverse le mode élite.          ║',10
        db '║                                                                              ║',10
        db '║ ²/V²  : utiliser READCONF au lieu de iREAD (rajoutez READCONF dans l''AUTOEXEC) ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²STRUCTURE DU CONFIG.SYS       ²                                               ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
        db '║²device=[lecteur][rep]<AUTOCONF.SYS> /[PARAM1] /[PARAM2] ²; appel d''²AUTOCONF².   ║',10
	db '║                                                                              ║',10
	db '║²device=²*²<DESIGNATION> <NOM DE LA CONFIG DU ²GROUPE PRINCIPAL²>²                  ║',10
	db '║                                                                              ║',10
        db '║        <DESIGNATION> : ²A² pour la configuration A, ²F1² pour la config F1, etc. ║',10
	db '║        <NOM DE LA CONFIG> : le nom de la configuration, avec le caractère ²|²  ║',10
	db '║                             pour changer entre des lettres majuscules et     ║',10
	db '║                             minuscules.                                      ║',10
	db '║                                                                              ║',10
	db '║ ²device=²**²<DESIGNATION> <NOM DE LA ²SOUS² CONFIG> ²                              ║',10
	db '║ ²... configuration ...²                                                        ║',10
        db '║ ²device=²**²<DESIGNATION> <NOM DE LA ²SOUS² CONFIG> ²                              ║',10
	db '║ ²... configuration ...²                                                        ║',10
	db '║ ²device=²***²<DESIGNATION> <NOM DE LA ²SOUS SOUS² CONFIG> ²                        ║',10
	db '║ ²... configuration ...²                                                        ║',10
        db '║ ²device=²*²<DESIGNATION> <NOM DE LA CONFIG DU ²GROUPE PRINCIPAL²>²                 ║',10
	db '║ ²... et ainsi de suite...²                                                     ║',10
	db '║                                                                              ║',10
        db '║ Note: Vous pouvez faire jusqu''à 20 niveaux de sous-configurations.           ║',10
        db '║                                                                              ║',10
        db '║ Note: Pour créer une couleur dans le nom de la configuration, le procédé est ║',10
        db '║       identique à celui des messages personalisés au démarrage d''²AUTOCONF².   ║',10
        db '║                                                                              ║',10
	db '║ Note: Seules les configurations du groupe principal peuvent être chargées en ║',10
	db '║       simplement appuiyant sur une touche au démarrage après le message du   ║',10
	db '║       démarrage du DOS, les sous configurations doivent être chargées à      ║',10
	db '║       partir de la liste des configurations, obtenue avec la BARRE D''ESPACE. ║',10
	db '║                                                                              ║',10
	db '║ Note: Les configurations peuvent être mises dans n''importe quel ordre. La    ║',10
	db '║       liste des configurations sera affichée dans l''ordre alphabétique, les  ║',10
	db '║       configurations étendues (F1...F10) d''abord.                            ║',10
	db '║                                                                              ║',10
	db '║ Note: Si vous n''avez pas créé de configuration par défaut, ²AUTOCONF² affiche  ║',10
	db '║       une erreur de configuration non-trouvée.                               ║',10
	db '║                                                                              ║',10
	db '║ Note: Si vous avez créé deux configurations avec la même lettre (ex: deux    ║',10
	db '║       configurations G, alors si vous choisissez la configuration G, LES DEUX║',10
	db '║       seront chargées, mais ceci est valable uniquement pour les configs du  ║',10
	db '║       groupe principal.                                                      ║',10
	db '║                                                                              ║',10
        db '║ ²device=²$² <------------------------>    ² ; rajoutez du texte quelconque, afin ║',10
        db '║                                         ; de laisser à ²AUTOCONF² la place     ║',10
        db '║                                         ; suffisante pour rajouter une       ║',10
        db '║                                         ; ligne SET CONF=... lors du         ║',10
        db '║                                         ; démarrage.                         ║',10
        db '║ Note: ceci remplace le READCONF.EXE des versions précédentes.                ║',10
        db '║                                                                              ║',10
        db '║ ²AUTOCONF² crée une variable dans l''environnement principal du DOS contenant:  ║',10
        db '║ GROUPE_CONFIG ou simplement CONFIG, en fonction de la configuration choisie. ║',10
        db '║ Ainsi, pour la configuration F6, la variable ²CONF² sera égale à F6 et elle    ║',10
        db '║ aura la valeur F3_F0_J_L pour la configuration L dans le sous groupe J du    ║',10
        db '║ sous groupe F10 du groupe principal F3.                                      ║',10
	db '║                                                                              ║',10
	db '║ ²îImportant!² Cette ligne doit figurer dans le CONFIG.SYS et signifie la fin    ║',10
	db '║ des configurations multiples. La suite est la partie commune, chargée avec   ║',10
	db '║ toutes les configurations.                                                   ║',10
	db '║                                                                              ║',10
	db '║ ²files=30                              ² ;est chargée avec chaque config.      ║',10
	db '║ ²buffers=30                            ²                                       ║',10
	db '║ ²lastdrive=E                           ²                                       ║',10
	db '║ ²stacks=9,128                          ²                                       ║',10
	db '║ ²... et ainsi de suite ...             ²                                       ║',10
        db '║                                                                              ║',10
        db '║ (exemple complet)                                                            ║',10
        db '║                                                                              ║',10        
        db '║ SWITCHES=/F                                                                  ║',10        
        db '║                                                                              ║',10        
        db '║ DEVICE=C:\UTILS\AUTOCONF.SYS /KSF /DF1 /F /5                                ║',10        
        db '║                                                                              ║',10        
        db '║ device=**F2 P|rogramming                                                     ║',10        
        db '║  device=c:\dos\himem.sys /testmem:off                                        ║',10        
        db '║  devicehigh=c:\dos\setver.exe                                                ║',10        
        db '║  devicehigh=c:\dos\ansi.sys                                                  ║',10        
        db '║                                                                              ║',10        
        db '║ device=*F1 DOS                                                               ║',10        
        db '║  device=c:\dos\himem.sys /testmem:off                                        ║',10        
        db '║  device=c:\dos\emm386.exe ram                                                ║',10        
        db '║  devicehigh=c:\utils\mtm\mtmcdai.sys /d:MTMIDE01                             ║',10        
        db '║  devicehigh=c:\dos\ansi.sys                                                  ║',10        
        db '║  shell=c:\dos\command.com /p                                                 ║',10        
        db '║                                                                              ║',10        
        db '║    device=**F0 DOS                                                           ║',10        
        db '║         device=c:\dos\himem.sys /testmem:off                                 ║',10        
        db '║         device=c:\dos\emm386.exe RAM                                         ║',10        
        db '║         devicehigh=c:\dos\ansi.sys                                           ║',10 
        db '║                                                                              ║',10        
        db '║    device=**F1 HIMEM/EMM386 (NOEMS)                                          ║',10        
        db '║         device=c:\dos\himem.sys /testmem:off                                 ║',10        
        db '║         device=c:\dos\emm386.exe NOEMS                                       ║',10        
        db '║         devicehigh=c:\dos\ansi.sys                                           ║',10        
        db '║         shell=c:\4dos\4dos.com /p                                            ║',10        
        db '║                                                                              ║',10        
        db '║ device=*W W|indows| (N|o| NETWORK)                                           ║',10        
        db '║         device=c:\dos\himem.sys /TESTMEM:OFF                                 ║',10        
        db '║         devicehigh=c:\utils\mtm\MTMCDAI.SYS /D:MTMIDE01                      ║',10        
        db '║         device=c:\dos\ansi.sys                                               ║',10        
        db '║         SHELL=C:\4DOS\4DOS.COM /P                                            ║',10        
        db '║                                                                              ║',10        
        db '║ device=$ <--------------------------->                                       ║',10        
        db '║                                                                              ║',10        
        db '║ buffers=40                                                                   ║',10        
        db '║ files=40                                                                     ║',10        
        db '║ dos=high,umb                                                                 ║',10        
        db '║ devicehigh=c:\dos\setver.exe                                                 ║',10        
        db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²STRUCTURE DE L''AUTOEXEC.BAT² (pour les confgis multiples)                     ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²goto %conf%              ²  ;saut vers la configuration choisie               ║',10
	db '║ ²goto def_conf            ²  ;au cas ou le nom est invalide, saut à la config  ║',10        
	db '║                                ;par défaut.                                  ║',10
	db '║                                                                              ║',10
	db '║ ²:def_conf      ²            ;configuration A arbitrairement celle par défaut  ║',10
	db '║ ²:A             ²            ;configuration A                                  ║',10
	db '║ ²...configuration...²                                                          ║',10
	db '║ ²goto end      ²             ;saut à la fin de l''AUTOEXEC.BAT                  ║',10
        db '║                                                                              ║',10
        db '║ ²:<DESIGNATION>[[_<SOUS CONF>]_<SOUS CONF>]  ²                                 ║',10
        db '║                                                                              ║',10
        db '║                            ;est la syntaxe générale; pour la sous-configura- ║',10
        db '║                            ;tion F8 sous la configuration F1, par exemple, il║',10
        db '║                            ;faudra spécifier: F1_F8. Pour plus d''informations║',10
        db '║                            ;consultez le point sur la variable CONF une page ║',10
        db '║                            ;plus haut.                                       ║',10
        db '║ ²goto end      ²             ;saut à la fin du AUTOEXEC.BAT                    ║',10
	db '║                                                                              ║',10
	db '║ ²:end          ²             ;partie COMMUNE                                   ║',10
	db '║ ²...           ²             ;PROMPT=..., PATH=..., etc...                     ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²TOUCHES                     ²                                                 ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²L''AIDE ON-LINE, obtenue depuis partout sauf sous TAB avec BACKSPACE:²         ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²FLECHES GAUCHE, HAUT ²une ligne plus haut                                     ║',10
	db '║ ²        DROITE, BAS  ²une ligne plus bas                                      ║',10
	db '║ ²PAGE DOWN            ²page suivante                                           ║',10
	db '║ ²PAGE UP              ²page précédente                                         ║',10
	db '║ ²ESC                  ²quitter l''aide                                          ║',10
	db '║ ²ESPACE               ²couleur - n/b                                           ║',10
	db '║ ²TABULATEUR           ²mode 25/50 lignes                                       ║',10
        db '║ ²INSERT               ²rechercher une chaîne de charactères                    ║',10
        db '║ ²DELETE               ²annuller le mode de recherche                           ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²LA LISTE DES CONFIGS, obtenue avec ESPACE à la place d''une config:²           ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²BACKSPACE            ²afficher l''aide on-line                                 ║',10
	db '║ ²ESPACE ou ENTREE     ²charger la configuration mise en évidence               ║',10
	db '║ ²FLECHES HAUT         ²scrolling vers la configuration précédente de la liste  ║',10
	db '║ ²        BAS          ²scrolling vers la configuration suivante de la liste    ║',10
	db '║ ²        DROITE       ²lister le sous-groupe s''il existe, sinon touche ignorée ║',10
	db '║ ²        GAUCHE       ²lister le groupe au dessus de sous groupe actuel        ║',10
	db '║ ²HOME & PAGE UP       ²première configuration sur l''ecran                      ║',10
	db '║ ²END & PAGE DOWN      ²dernière confiration sur l''ecran                        ║',10
	db '║ ²TABULATEUR           ²afficher la configuration mise en évidence              ║',10
        db '║ ²ETOILE               ²terminer ²AUTOCONF²                                       ║',10
	db '║ ²POINT                ²charger que la partie commune                           ║',10
	db '║ Toute autre touche désignant une configuration, la charge, si elle existe.   ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²AFFICHAGE DE LA CONFIG MEME, obtenu avec TAB sous la liste des configs:      ²║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²FLECHES:             ²                                                        ║',10
	db '║ ²HAUT                 ²scrolling de la configuration vers le haut              ║',10
	db '║ ²BAS                  ²scrolling de la configuration vers le bas               ║',10
	db '║ ²DROITE               ²scrolling de la configuration à droite                  ║',10
	db '║ ²GAUCHE               ²scrolling de la configuration à gauche                  ║',10
	db '║ ²HOME                 ²sauter au début de la ligne                             ║',10
	db '║                      si la configuration excède 25 lignes/80 colonnes        ║',10
	db '║ ²PAGE DOWN            ²configuration suivante                                  ║',10
	db '║ ²PAGE UP              ²configuration précédente                                ║',10
	db '║ ²TAB, ESC             ²retourner dans la liste des configurations              ║',10
	db '║ ²ESPACE               ²changer entre le mode couleur - n/b                     ║',10
	db '║ ²ENTREE               ²choisir la configuration actuelle                       ║',10
	db '║ ²POINT (.)            ²charger que la partie commune après DEVICE=$            ║',10
        db '║ ²BACKSPACE            ²afficher l''aide on-line                                 ║',10
        db '║ ²E (Touche E)         ²mode activer/désactiver des lignes                      ║',10
        db '║ ²  ESPACE en mode ''E'' ²activer/désactiver une ligne                            ║',10
        db '║ ²       ? en mode ''E'' ²activer/désactiver la demande d''exécuter la ligne       ║',10
        db '╠══════════════════════════════════════════════════════════════════════════════╣',10
        db '║ ²COMPATIBILITE AVEC WINDOWS 95:                      ²                         ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
        db '║ Version 2.6+ supporte Windows 95!                                            ║',10
	db '║                                                                              ║',10
	db '║ Cela implique:                                                               ║',10
	db '║                                                                              ║',10
        db '║ 1. Lorsque vous initialisez l''ordinateur avec Windows 95 installé, un choix  ║',10
        db '║ de charger Win 95 ou le DOS précédent vous est offert. F4 charge le DOS et   ║',10
        db '║ une autre touche Win 95. Ceci vous permet de retrouver sans dégats votre     ║',10
	db '║ commutateur de commandes comme 4DOS, NDOS ou COMMAND.COM.                    ║',10
	db '║                                                                              ║',10
	db '║ Les applications 16 bits et toutes celles qui tournent sous DOS inférieur à  ║',10
	db '║ 7.0 nécéssitent toujours des configurations multiples. Ainsi, losque vous    ║',10
        db '║ faites le choix de charger Win 95, l''option /Dx sera ignorée et /Hx pris en  ║',10
        db '║ compte. Ceci vous permet d''avoir une configuration par défaut pour Win 95,   ║',10
	db '║ et une autre configuration par défaut pour DOS, sans avoir à choisir encore  ║',10
	db '║ une configuration pour l''un des deux.                                        ║',10
	db '║                                                                              ║',10
        db '║ 2. ²AUTOCONF² forcera l''ecran de passer en mode normal, au cas où Windows 95   ║',10
	db '║ est en train d''initialiser l''ordinateur. Ceci permet de voir ce qui se passe ║',10
        db '║ derière le magnifique dessin de chargement de Win 95 et pleinement profiter  ║',10
	db '║ des possibilités d''²AUTOCONF!²                                                 ║',10
	db '║                                                                              ║',10
        db '║ 3. Windows 95, DOS et QEMM 7.x DOSDATA:                                      ║',10
	db '║                                                                              ║',10
	db '║ Si vous utilisez des configurations avec le DOSDATA de QEMM, vous êtes forcés║',10
	db '║ de fare la procédure suivante:                                               ║',10
	db '║                                                                              ║',10
	db '║      # appuyer sur F4 pour lancer MS-DOS                                     ║',10
	db '║      # choisir une configuration avec AUTOCONF, contenant DOSDATA            ║',10
	db '║      # appuyer de nouveau sur F4, puisque DOSDATA reinitialise le CONFIG.SYS ║',10
	db '║                                                                              ║',10
	db '║ Avec l''option ²/O²:                                                            ║',10
	db '║                                                                              ║',10
        db '║ La dernière étape est supprimée avec ²AUTOCONF² 2.61+. Appuyez simplement sur  ║',10
	db '║ F4, puis choisissez une configuration avec DOSDATA!                          ║',10
	db '║                                                                              ║',10
	db '║ Note: certains anciens bios ne supportent pas cette fonction                 ║',10
	db '║                                                                              ║',10
	db '║ Note: la touche F4 sera simulée dans tous les cas, sauf si vous lancez       ║',10
        db '║       Win 95. Si DOSDATA n''est pas présent, un beep sera émis à la fin du    ║',10  
	db '║       démarrage, puisque l''ordinateur garde la touche jusqu''à la ligne des   ║',10
	db '║       commandes. Un petit utilitaire a été rajouté: CLRBUF.SYS et CLRBUF.COM,║',10
	db '║       permettant d''effacer le buffer clavier, ainsi supprimant ce beep.      ║',10
	db '║       CLRBUF ne prend pas de mémoire et n''affiche rien à son exécution.      ║',10
	db '║       Utilisez CLRBUF.SYS dans la partie commune des configurations du       ║',10
	db '║       fichier CONFIG.SYS ou CLRBUF.COM dans l''AUTOEXEC.BAT.                  ║',10
        db '║                                                                              ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
        db '║ ² NOTE IMPORTANTE POUR LE SUPPORT DE WINDOWS 95:²                              ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
        db '║ ²AUTOCONF² 2.90 a été testé avec Windows 95, version finale du 24 août 1995.   ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²NOTES IMPORTANTES:²                                                           ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ La ligne: DOS=[HIGH],[UMB] est lue une seule fois dans tout le CONFIG.SYS:   ║',10
	db '║ seule la dernière occurence de cette ligne est prise en compte au démarrage. ║',10        
	db '║ ²AUTOCONF² ne peut donc pas intervenir quand à la sélection de ce paramètre.   ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
        db '║ ²AUTOCONF², version 1.1 à cette dérnière, toutes les versions de ²READCONF², de  ║',10
        db '║ ²i²R²E²A²D² et de ²BOOTIT² sont la propriété de (moi):                               ║',10
        db '║ ²▄▄▄▄▄▄▄▄▄▄▄ ²Doubrovkine Daniel      ²                                         ║',10
        db '║ ²████³███²████ ²11, ch. de la Clairière ²                                         ║',10
	db '║ ²██³███████²██ ²1207 Genève,            ²                                         ║',10
	db '║ ²████³███²████ ²Suisse                  ²                                         ║',10
	db '║ ²▀▀▀▀▀▀▀▀▀▀▀ ²tél & fax: 41 22 - 735 69 47       ²                              ║',10
        db '║ ²email: dblock@infomaniak.ch                      ²                            ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²AUTOCONF² est une conception à l''origine d''un programmeur français qui m''est  ║',10
	db '║ inconnu. Une version qui m''a servi de support est parue dans un SVM il y a   ║',10
	db '║ quelques années. Les 90% du programme original ont étés modifiés. Le nom n''a ║',10
        db '║ pas été changé.                                                              ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
        db '║ Je remercie tous les bétà testeurs et tous ceux qui on pris part, quelle     ║',10
	db '║ qu''elle soit dans la création de ce programme.                               ║',10
	db '╠══════════════════════════════════════════════════════════════════════════════╣',10
	db '║ ²Tous les noms de compagnies mentionnés, ainsi que leurs produits, sont des  ² ║',10
	db '║ ²marques déposées de leurs propriétaires respectifs.²                          ║',10
	db '╚══════════════════════════════════════════════════════════════════════════════╝',10
	db '²[                             fin de l''aide                                    '
			     
